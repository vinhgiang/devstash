# Neon PostgreSQL — development branch connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=

# Set to "true" only when self-hosting outside Vercel/Netlify/Cloudflare
# (e.g. running `npm run start` locally). On those platforms NextAuth
# auto-detects and this should stay unset.
AUTH_TRUST_HOST=

# GitHub OAuth — register an app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
