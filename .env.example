# Neon PostgreSQL — development branch connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth — register an app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set to "true" only when self-hosting outside Vercel/Netlify/Cloudflare
# (e.g. running `npm run start` locally). On those platforms NextAuth
# auto-detects and this should stay unset.
AUTH_TRUST_HOST=

# Context7 MCP — get a key at https://context7.com (referenced by .mcp.json)
CONTEXT7_API_KEY=

RESEND_API_KEY=

# Set to "false" to disable email verification (dev without a linked Resend domain).
# Any other value (including unset) keeps verification required.
REQUIRE_EMAIL_VERIFICATION=false

# From-address for transactional email. Must be on a verified Resend domain.
# In dev with no verified domain, use "onboarding@resend.dev" (only delivers
# to the Resend account owner's email).
EMAIL_FROM="DevStash <onboarding@resend.dev>"

# Public app URL — used to build verification links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=